<UserControl
    x:Class="LiveCaptionsTranslator.controls.SecretInput"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <PasswordBox
            x:Name="MaskedInput"
            Height="30"
            Padding="10,4,10,7"
            FontSize="13.3"
            PasswordChanged="MaskedInput_PasswordChanged" />
        <ui:TextBox
            x:Name="VisibleInput"
            Height="30"
            Padding="10,4,10,7"
            FontSize="13.3"
            TextChanged="VisibleInput_TextChanged"
            Visibility="Collapsed" />
        <Button
            x:Name="VisibilityToggle"
            Grid.Column="1"
            Margin="5,0,0,0"
            Padding="6,2"
            Click="VisibilityToggle_Click"
            ToolTip="Temporarily show or hide this secret" />
    </Grid>
</UserControl>
